{
  "name": "oregand-github-io",
  "version": "1.1.0",
  "description": "David O'Regan's personal website",
  "private": true,
  "scripts": {
    "dev": "postcss css/styles.css -o css/output.css --watch",
    "build": "NODE_ENV=production postcss css/styles.css -o css/output.css && esbuild js/skyline.js --bundle --minify --format=esm --outfile=js/skyline.bundle.js",
    "build:skyline": "node scripts/build-skyline.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.14",
    "cssnano": "^6.0.0",
    "esbuild": "^0.25.0",
    "meshoptimizer": "^0.25.0",
    "postcss": "^8.4.24",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.3.2"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "three": "^0.180.0",
    "xml2js": "^0.6.2"
  }
}
